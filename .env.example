# Neon Serverless Postgres Connection Strings
DATABASE_URL="postgres://neondb_owner:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?channel_binding=require&sslmode=require"
DATABASE_URL_UNPOOLED="postgres://neondb_owner:password@ep-sample.us-east-2.aws.neon.tech/neondb?channel_binding=require&sslmode=require"
NEON_BRANCH="production"
NEON_BRANCH_ID="br-sample-id"

# Application Security & Cryptography (AES-256-GCM & Session Auth)
# Generate 32 bytes hex: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
SESSION_SECRET="super-secure-jwt-session-secret-at-least-32-chars-long"

# WhatsApp Business Cloud API
WHATSAPP_TOKEN="EAAG..."
WHATSAPP_PHONE_NUMBER_ID="109876543210"
WHATSAPP_WEBHOOK_SECRET="gh_wh_webhook_secret_verification_token"

# Ghana SMS Gateway Fallback (Arkesel / mNotify / Hubtel)
SMS_PROVIDER="arkesel"
SMS_API_KEY="arkesel_api_key_sample"
SMS_SENDER_ID="GhanaHealth"

# Cron & Background Automation Security
CRON_SECRET="secure_cron_trigger_token_9876"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

